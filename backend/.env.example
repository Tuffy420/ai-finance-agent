# =========================================================================
# FinPilot AI - Environment Configuration
# =========================================================================

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL=sqlite+aiosqlite:///./finpilot.db
SYNC_DATABASE_URL=sqlite:///./finpilot.db

# Redis Cache & Rate Limiting
REDIS_URL=redis://localhost:6379/0

# JWT & Security
JWT_SECRET_KEY=finpilot_super_secret_jwt_encryption_key_32_chars_min
ENCRYPTION_KEY=D7z1bM3bQ5r7s9v1x3z5b7d9f1h3j5l7n9p1r3t5v7x=

# =========================================================================
# Google Gemini API Key (Paste your Google Gemini API key below)
# =========================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional: OpenAI API Key (Leave empty if using Gemini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google / Apple OAuth (Optional for local testing)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Firebase Cloud Messaging (Optional)
FIREBASE_CREDENTIALS_PATH=
